{
  "name": "socialos-mcp",
  "version": "0.1.0",
  "description": "Steerpost MCP server (Streamable HTTP + stdio) that proxies the Steerpost REST API",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "socialos-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-size.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
